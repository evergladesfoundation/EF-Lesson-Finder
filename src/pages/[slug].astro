---
import Layout from '../layouts/Layout.astro';
import { pages, type SitePage } from '../data/pages';

export function getStaticPaths() {
  return pages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

interface Props {
  page: SitePage;
}

const { page } = Astro.props;
---

<Layout title={page.title} description={page.intro}>
  <section class="page-hero">
    <img src={page.image} alt="" aria-hidden="true" />
    <div class="page-hero-overlay"></div>
    <div class="page-hero-content">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1>{page.title}</h1>
      <p>{page.intro}</p>
    </div>
  </section>

  <div class="page-content">
    {
      page.sections.map((section, index) => (
        <section class:list={['content-section', { tinted: index % 2 === 1 }]}>
          <div class="section-number">{String(index + 1).padStart(2, '0')}</div>
          <div>
            <h2>{section.heading}</h2>
            {section.body?.map((paragraph) => <p>{paragraph}</p>)}
            {section.items && (
              <ul class="resource-list">
                {section.items.map((item) => <li>{item}</li>)}
              </ul>
            )}
          </div>
        </section>
      ))
    }
  </div>

  <section class="cta-band">
    <p>Bring the Everglades into your school.</p>
    <h2>Resources for every learner, PreK through grade 12.</h2>
    <div>
      <a class="button light" href="/teacher-toolkit">Explore the toolkit</a>
      <a class="text-link" href="/getinvolved">Get involved <span>→</span></a>
    </div>
  </section>
</Layout>
