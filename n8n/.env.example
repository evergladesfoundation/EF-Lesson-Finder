# Everglades Lesson Finder — n8n setup values
# Copy to n8n/.env and fill in. Do not commit .env.
# Use this file as a scratch pad while creating n8n credentials and filling node placeholders.

# =============================================================================
# n8n Cloud
# Instance: https://evergladesfoundation.app.n8n.cloud
# API keys: Settings → n8n API  (not available on the free trial)
# =============================================================================
N8N_BASE_URL=https://evergladesfoundation.app.n8n.cloud
N8N_API_KEY=
# Optional: Settings → Instance-level MCP → Access token (for Cursor MCP)
N8N_MCP_TOKEN=

# After import, paste the workflow IDs from the URL (.../workflow/<id>)
N8N_WF2_ID=
N8N_WF1_ID=
N8N_WF4_ID=
N8N_WF3_ID=

# =============================================================================
# Postgres / Supabase
# Project Settings → Database → Connection string
# Use Direct connection or Session pooler (port 5432). Do NOT use Transaction
# pooler (port 6543) — n8n's Postgres node keeps a session and will fail there.
# SSL: Require
# =============================================================================
POSTGRES_HOST=db.YOUR_PROJECT_REF.supabase.co
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_SSL=require

# =============================================================================
# Google Drive (Managed OAuth2 on n8n Cloud — Sign in with Google)
# Folder ID is the last segment of the folder URL:
#   https://drive.google.com/drive/folders/<GOOGLE_DRIVE_FOLDER_ID>
# =============================================================================
GOOGLE_DRIVE_FOLDER_ID=

# =============================================================================
# Microsoft 365 — Outlook + Excel (OneDrive)
# n8n Cloud: Credentials → Microsoft Outlook / Microsoft Excel → Connect my account
# Workbook ID: in the Excel node, switch Workbook to "By ID" (or pick From list
# after OAuth). Graph item ID, not the SharePoint sourcedoc GUID.
# =============================================================================
ONEDRIVE_WORKBOOK_ID=
ONEDRIVE_WORKSHEET_NAME=
OUTLOOK_MAILBOX=

# =============================================================================
# OpenAI  (https://platform.openai.com/api-keys)
# Organization ID only needed if the key belongs to multiple orgs.
# =============================================================================
OPENAI_API_KEY=
OPENAI_ORGANIZATION_ID=
